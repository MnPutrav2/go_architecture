# application name
APP_NAME=

# db config
DB_TYPE=postgres
DB_ADDR=
DB_PORT=
DB_NAME=
DB_USER=
DB_PASS=
SSL_MODE=disable
AUTO_MIGRATE=true

# IP port
IP_DEVS=0.0.0.0
IP_PROD=localhost
IP_PORT=8080

LISTEN_DEVS=${IP_DEVS}:${IP_PORT}
LISTEN_PROD=${IP_PROD}:${IP_PORT}

# encription/decription pepper
PEPPER=

# token
JWT_SECURE_KEY=
JWT_EXPIRED_HOUR=5
ALLOW_ORIGIN=

# Mode = PROD/DEV
MODE=DEV